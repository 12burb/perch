{
  "name": "@perch/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript SDK generated from the OpenAPI document at /api/openapi.json.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts --export-type"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
