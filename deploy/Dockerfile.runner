# syntax=docker/dockerfile:1.7
# perch/runner (spec §3.1, §3.2, §8): Ubuntu 24.04 with Bun, Node LTS, Python + uv, git, ripgrep, tmux,
# Playwright's Chromium, and the runner agent (apps/runner, task 1.1) as the entrypoint. The pinned
# OpenCode binary and the official CLIs (claude, codex, gemini, hermes) arrive with the engine tasks.
# Homes live at /data/homes/<user>; projects at /data/projects. Build from the repository root.
ARG UBUNTU_VERSION=24.04
ARG BUN_VERSION=1.3.11

# The agent's runtime tree, production dependencies only (the same recipe as the api image, ADR-0062).
FROM oven/bun:${BUN_VERSION} AS agent
WORKDIR /app
COPY package.json bun.lock turbo.json tsconfig.base.json biome.json ./
COPY apps ./apps
COPY packages ./packages
COPY connectors ./connectors
COPY templates ./templates
COPY spikes ./spikes
COPY scripts ./scripts
RUN bun install --frozen-lockfile --ignore-scripts
RUN mkdir -p /prod \
 && find apps packages connectors templates spikes scripts -name package.json -not -path '*/node_modules/*' -exec cp --parents {} /prod/ \; \
 && cp package.json bun.lock tsconfig.base.json /prod/ \
 && tar cf - --exclude=node_modules apps/runner packages | tar xf - -C /prod \
 && cd /prod \
 && bun install --frozen-lockfile --ignore-scripts --production --omit=peer --filter @perch/runner

FROM ubuntu:${UBUNTU_VERSION}
ARG BUN_VERSION
ARG NODE_VERSION=24.21.0
ARG UV_VERSION=0.12.13
ARG PLAYWRIGHT_VERSION=1.62.1
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    BUN_INSTALL=/opt/bun \
    UV_INSTALL_DIR=/opt/uv \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    PATH=/opt/bun/bin:/opt/uv:/opt/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl unzip xz-utils git ripgrep tmux openssh-client jq less procps \
      python3 python3-venv build-essential pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Node LTS from the official tarball, verified against SHASUMS256.
RUN set -eux; \
    case "${TARGETARCH}" in amd64) arch=x64 ;; arm64) arch=arm64 ;; *) echo "unsupported arch ${TARGETARCH}"; exit 1 ;; esac; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${arch}.tar.xz"; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt"; \
    grep " node-v${NODE_VERSION}-linux-${arch}.tar.xz\$" SHASUMS256.txt | sha256sum -c -; \
    mkdir -p /opt/node && tar -xJf "node-v${NODE_VERSION}-linux-${arch}.tar.xz" -C /opt/node --strip-components=1; \
    rm -f "node-v${NODE_VERSION}-linux-${arch}.tar.xz" SHASUMS256.txt; \
    node --version

# Bun, pinned.
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v${BUN_VERSION}" && bun --version

# uv (and through it, Python toolchains), pinned.
RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | sh && uv --version

# Playwright's Chromium and its system dependencies (agent eyes and preview screenshots, spec §5.6).
RUN npx --yes "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium && rm -rf /root/.npm

RUN groupadd --gid 1000 perch && useradd --uid 1000 --gid perch --create-home --shell /bin/bash perch \
    && mkdir -p /data/homes /data/projects && chown -R perch:perch /data /opt/pw-browsers
COPY --from=agent --chown=perch:perch /prod /opt/perch
USER perch
WORKDIR /data/projects
# The runner agent (spec §7.6): PERCH_API_URL and PERCH_RUNNER_TOKEN come from the supervisor.
ENTRYPOINT ["bun", "/opt/perch/apps/runner/src/main.ts"]
