# syntax=docker/dockerfile:1.7
# perch/api (spec §8): the api, worker, and supervisor entrypoints in one image.
# Bun runs the TypeScript sources directly; the web app is built once with Vite (which needs Node).
ARG BUN_VERSION=1.3.11
ARG NODE_VERSION=24.21.0

FROM node:${NODE_VERSION}-bookworm-slim AS node

FROM oven/bun:${BUN_VERSION} AS build
WORKDIR /app
# Vite runs under Node (ADR-0037); Bun installs and runs everything else.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY package.json bun.lock turbo.json tsconfig.base.json biome.json ./
# Every workspace in bun.lock must be present for a frozen install (apps/*, packages/*, connectors,
# templates, spikes/*, scripts); .dockerignore keeps installs, builds, and .env files out of the context.
COPY apps ./apps
COPY packages ./packages
COPY connectors ./connectors
COPY templates ./templates
COPY spikes ./spikes
COPY scripts ./scripts
RUN bun install --frozen-lockfile
RUN bun run --filter @perch/web build

FROM oven/bun:${BUN_VERSION}-slim AS runtime
ARG PERCH_VERSION=0.0.0
ARG PERCH_COMMIT=
ENV NODE_ENV=production \
    PERCH_VERSION=${PERCH_VERSION} \
    PERCH_COMMIT=${PERCH_COMMIT} \
    PERCH_FILES_DIR=/data/files \
    PERCH_DATA_DIR=/data \
    PORT=3000 \
    HOST=0.0.0.0
WORKDIR /app
COPY --from=build --chown=bun:bun /app/package.json /app/bun.lock ./
COPY --from=build --chown=bun:bun /app/node_modules ./node_modules
COPY --from=build --chown=bun:bun /app/apps/api ./apps/api
COPY --from=build --chown=bun:bun /app/apps/web/dist ./apps/web/dist
COPY --from=build --chown=bun:bun /app/apps/web/package.json ./apps/web/package.json
COPY --from=build --chown=bun:bun /app/packages ./packages
RUN mkdir -p /data/files && chown -R bun:bun /data
USER bun
VOLUME ["/data/files"]
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD bun -e 'const r = await fetch("http://127.0.0.1:3000/api/health"); process.exit(r.ok ? 0 : 1)'
ENTRYPOINT ["bun", "apps/api/src/index.ts"]
# api (default) | worker | supervisor
CMD ["api"]
