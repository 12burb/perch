# syntax=docker/dockerfile:1.7
# perch/api (spec §8): the api, worker, and supervisor entrypoints in one image.
# Bun runs the TypeScript sources directly; the web app is built once with Vite (which needs Node).
ARG BUN_VERSION=1.3.11
ARG NODE_VERSION=24.21.0

FROM node:${NODE_VERSION}-bookworm-slim AS node

FROM oven/bun:${BUN_VERSION} AS build
WORKDIR /app
# Vite runs under Node (ADR-0037); Bun installs and runs everything else.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY package.json bun.lock turbo.json tsconfig.base.json biome.json ./
# Every workspace in bun.lock must be present for a frozen install (apps/*, packages/*, connectors,
# templates, spikes/*, scripts); .dockerignore keeps installs, builds, and .env files out of the context.
COPY apps ./apps
COPY packages ./packages
COPY connectors ./connectors
COPY templates ./templates
COPY spikes ./spikes
COPY scripts ./scripts
# --ignore-scripts: the only trusted install script (node-pty, the opt-in PTY probe in spikes/pty) needs
# node-gyp and Python; nothing that runs in this image needs a lifecycle script.
RUN bun install --frozen-lockfile --ignore-scripts
RUN bun run --filter @perch/web build
# The runtime tree (ADR-0062): the api workspace, the packages it links, and the web build, with
# production dependencies only, installed fresh from the same lockfile (Bun's isolated store never
# prunes in place). --omit=peer keeps better-auth's optional drizzle-kit peer, and esbuild with it, out;
# every peer the api needs is one of its direct dependencies. connectors/ carries the provider
# manifests the api imports as text (task 1.16), so its source ships too; the other workspaces
# contribute only the manifests the frozen install requires.
RUN mkdir -p /prod \
 && find apps packages connectors templates spikes scripts -name package.json -not -path '*/node_modules/*' -exec cp --parents {} /prod/ \; \
 && cp package.json bun.lock tsconfig.base.json /prod/ \
 && tar cf - --exclude=node_modules apps/api packages connectors apps/web/dist | tar xf - -C /prod \
 && cd /prod \
 && bun install --frozen-lockfile --ignore-scripts --production --omit=peer --filter @perch/api

FROM oven/bun:${BUN_VERSION}-slim AS runtime
ARG PERCH_VERSION=0.0.0
ARG PERCH_COMMIT=
ENV NODE_ENV=production \
    PERCH_VERSION=${PERCH_VERSION} \
    PERCH_COMMIT=${PERCH_COMMIT} \
    PERCH_FILES_DIR=/data/files \
    PERCH_DATA_DIR=/data \
    PORT=3000 \
    HOST=0.0.0.0
# Debian security updates for the base image: the compose smoke gates on Trivy's fixed HIGH/CRITICAL findings.
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=bun:bun /prod ./
RUN mkdir -p /data/files && chown -R bun:bun /data
USER bun
VOLUME ["/data/files"]
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD bun -e 'const r = await fetch("http://127.0.0.1:3000/api/health"); process.exit(r.ok ? 0 : 1)'
ENTRYPOINT ["bun", "apps/api/src/index.ts"]
# api (default) | worker | supervisor
CMD ["api"]
