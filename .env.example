# Perch environment (spec §8). Copy to .env, or let `perch init` write it. Defaults in parentheses.
# Never commit .env.

# --- Required in team mode (docker compose) ---
# The URL people use; drives every callback, webhook, passkey origin, and deep link.
PERCH_PUBLIC_URL=https://perch.example.com
# 32 random bytes, base64 (openssl rand -base64 32). Generated in laptop mode; required in team mode.
PERCH_MASTER_KEY=
# Postgres password for the compose postgres service (DATABASE_URL is derived from it by compose).
POSTGRES_PASSWORD=
# Pinned release for every perch image (perch init writes the version it shipped with).
PERCH_IMAGE_TAG=latest

# --- Database ---
# pglite://<dir> for laptop mode (default pglite://~/.perch/data), postgres://… for team mode.
# DATABASE_URL=postgres://perch:<password>@postgres:5432/perch

# --- Previews (optional) ---
# Wildcard domain for previews (unset → path mode /p/<workspace>/<port>/).
# Previews get a hostname each: <port>--<workspace>.<this domain> (spec §5.6). Point it at a name
# under the same domain as PERCH_PUBLIC_URL — perch.example.com itself, or preview.example.com
# beside app.example.com — so a framed preview stays same-site with Perch and keeps you signed in.
# Unset means path-mode previews at /p/<workspace>/<port>/, which need no DNS and no certificate.
# PERCH_PREVIEW_DOMAIN=preview.perch.example.com
# The Caddy DNS-challenge module (built into deploy/Dockerfile.caddy) and its token.
# CADDY_DNS_PROVIDER=cloudflare
# CADDY_DNS_TOKEN=

# --- Runners ---
# docker | shared | inprocess (docker in team mode, inprocess in laptop mode)
# PERCH_RUNNER_MODE=docker
# PERCH_RUNNER_IMAGE=ghcr.io/12burb/perch-runner:latest
# PERCH_RUNNER_LIMITS=cpus=2,memory=4g,pids=512
# PERCH_RUNNER_IDLE_MINUTES=30
# What runner containers reach the api at (the supervisor sets it in runner containers; compose: http://api:3000)
# PERCH_RUNNER_API_URL=http://api:3000
# Volume and network names for runner containers; by default mirrored from the supervisor's own mounts
# PERCH_RUNNER_HOMES_VOLUME=perch_runner_homes
# PERCH_RUNNER_PROJECTS_VOLUME=perch_projects
# PERCH_RUNNER_NETWORK=perch_default
# Engines on a runner: the ACP agent for sessions that name none, extra agents, and an
# `opencode serve` already running (nothing is spawned per project then)
# PERCH_ACP_AGENT=gemini
# PERCH_ACP_AGENTS={"my-agent":{"name":"My Agent","command":"my-agent"}}
# PERCH_OPENCODE_URL=http://127.0.0.1:4096

# --- Files ---
# PERCH_FILES_DIR=/data/files
# Any S3-compatible bucket instead of the local volume:
# PERCH_S3_ENDPOINT=
# PERCH_S3_BUCKET=
# PERCH_S3_KEY=
# PERCH_S3_SECRET=
# PERCH_S3_REGION=

# --- Email, telemetry, logs ---
# PERCH_SMTP_URL=smtp://user:pass@smtp.example.com:587   (unset → invite and reset links are logged)
# PERCH_TELEMETRY=off                                     (the setup wizard can turn it on)
# PERCH_OTLP_ENDPOINT=
# PERCH_LOG_LEVEL=info

# --- Auth ---
# PERCH_SESSION_SECRET=      (derived from the master key when unset)
# PERCH_OIDC_ISSUER=
# PERCH_OIDC_CLIENT_ID=
# PERCH_OIDC_CLIENT_SECRET=
# PERCH_ALLOW_LOOPBACK_REDIRECTS=false   (true in laptop mode)

# --- Brains (models) ---
# Keys and endpoints live in the vault, added in workspace settings — never here.
# PERCH_OLLAMA_URL=http://127.0.0.1:11434/v1   (extra places to look for a local Ollama, comma-separated)

# --- Bots (task 2.6) ---
# Where a bot's web_search tool goes: a Brave-shaped endpoint and the key it takes. Without these
# the tool exists but says it is not configured, and nothing else about a bot changes.
# PERCH_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
# PERCH_SEARCH_KEY=

# --- Misc ---
# PERCH_DEFAULT_LOCALE=en
# PERCH_DEMO_WORKSPACE=true   (first run)
# PERCH_FLAGS=cli_harness     (feature flags to turn on, comma-separated; default off)
# TUNNEL_TOKEN=               (docker compose --profile tunnel)
